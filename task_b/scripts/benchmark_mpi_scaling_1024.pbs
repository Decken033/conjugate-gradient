#!/bin/bash
# MPI CG strong-scaling benchmark: 2D Poisson 1024x1024
#
# Larger problem for improved scaling behavior at high rank counts.
# N = 1,048,576 unknowns.
# Rank counts: 1, 2, 4, 8, 16, 32, 36, 72
# Per configuration: 4 warmups + 10 timed runs
#
# Memory estimate per rank:
#   Matrix local rows: ~N/P rows, ~5*N/P nonzeros
#   Full x vector: N doubles = 8 MB
#   Total: ~80-160 MB for small rank counts
#   32GB per node should be sufficient for all rank counts.
#
# Usage:
#   qsub scripts/benchmark_mpi_scaling_1024.pbs

#PBS -N dsa5208_mpi_scaling_1024
# Supply the allocation account with qsub -P ACCOUNT.
#PBS -q auto
#PBS -l select=2:ncpus=36:mpiprocs=36:mem=64gb
#PBS -l place=scatter
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

PROJECT_DIR="${TASK_B_DIR:?Set TASK_B_DIR to the absolute task_b directory}"

echo "=== DSA5208 MPI CG Scaling Benchmark 1024x1024 ==="
echo "PBS job ID: $PBS_JOBID"
echo "Host: $(hostname)"
echo "Nodes: $(cat $PBS_NODEFILE | sort -u | paste -s -d,)"
echo "Timestamp: $(date)"

# Load modules
module purge
module load CMake/3.27.6-GCCcore-13.2.0
module load OpenMPI/4.1.6-GCC-13.2.0

# Verify versions
g++ --version | head -1
mpirun --version | head -1

cd "$PROJECT_DIR"

# Build
cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
cmake --build build --parallel 8 --target run_mpi_benchmark

mkdir -p results/mpi

lscpu | grep -E \
    '^Model name:|^CPU\(s\):|^Thread\(s\) per core:|^Core\(s\) per socket:'

# OpenMPI's PBS integration may be unavailable on compute nodes. Build an
# explicit hostfile from PBS's allocation so multi-node launches see all slots.
MPI_HOSTFILE="${PROJECT_DIR}/results/mpi/mpi_hostfile_${PBS_JOBID}"
awk '{slots[$1]++} END {for (host in slots) print host " slots=" slots[host]}' \
    "$PBS_NODEFILE" > "$MPI_HOSTFILE"
trap 'rm -f "$MPI_HOSTFILE"' EXIT

MATRIX_SIZE=1024
REPEATS=10
WARMUPS=4
RESULTS_DIR="results/mpi"

echo ""
echo "=== 2D Poisson ${MATRIX_SIZE}x${MATRIX_SIZE} (N=$((MATRIX_SIZE*MATRIX_SIZE))) ==="

for RANKS in 1 2 4 8 16 32 36 72; do
    OUTPUT_FILE="${RESULTS_DIR}/mpi_2d${MATRIX_SIZE}_p${RANKS}_${PBS_JOBID}.csv"

    echo "--- Ranks: ${RANKS} ---"
    mpirun -np "${RANKS}" \
        --hostfile "$MPI_HOSTFILE" \
        -x PATH \
        -x LD_LIBRARY_PATH \
        --map-by slot \
        --bind-to core \
        ./build/run_mpi_benchmark \
            2d "${MATRIX_SIZE}" \
            "${REPEATS}" \
            "${OUTPUT_FILE}" \
            "${WARMUPS}"
    echo ""
done

echo "=== 1024x1024 scaling completed ==="
