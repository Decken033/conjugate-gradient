#!/bin/bash
# MPI CG correctness tests on NUS Vanda HPC
#
# Runs the three MPI test executables with 1, 2, and 4 ranks.
# Must be run on an allocated compute node (not login node).
#
# Resources: 1 node, 4 cores, 4 MPI slots (sufficient for mpi_cg test)
#
# Usage:
#   qsub scripts/test_mpi_correctness.pbs

#PBS -N dsa5208_mpi_tests
# Supply the allocation account with qsub -P ACCOUNT.
#PBS -q auto
#PBS -l select=1:ncpus=4:mpiprocs=4:mem=4gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

echo "=== DSA5208 MPI CG Correctness Tests ==="
echo "PBS job ID: $PBS_JOBID"
echo "Host: $(hostname)"
echo "Timestamp: $(date)"

module load CMake/3.27.6-GCCcore-13.2.0
module load openmpi/gcc/64/4.1.8

g++ --version | head -1
mpicxx --showme 2>&1 | head -1

cd "${TASK_B_DIR:?Set TASK_B_DIR to the absolute task_b directory}"

# Build all targets including tests
cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
cmake --build build --parallel 4

echo ""
echo "=== CTest (all tests) ==="
# Run all tests including MPI CTest targets
ctest --test-dir build --output-on-failure -j 1

echo ""
echo "=== Additional manual MPI test runs ==="

# Run partition tests with 1, 2, 4 ranks
for RANKS in 1 2 4; do
    echo ""
    echo "--- test_mpi_partition with ${RANKS} rank(s) ---"
    mpirun -np "${RANKS}" ./build/test_mpi_partition
done

# Run SpMV tests
for RANKS in 1 2 4; do
    echo ""
    echo "--- test_mpi_spmv with ${RANKS} rank(s) ---"
    mpirun -np "${RANKS}" ./build/test_mpi_spmv
done

# Run CG tests
for RANKS in 1 2 4; do
    echo ""
    echo "--- test_mpi_cg with ${RANKS} rank(s) ---"
    mpirun -np "${RANKS}" ./build/test_mpi_cg
done

echo ""
echo "=== All MPI correctness tests completed ==="
