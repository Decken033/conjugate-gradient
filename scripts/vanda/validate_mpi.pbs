
#!/bin/bash
#PBS -N mpi_validation
#PBS -P personal-diqingxu
#PBS -q auto
#PBS -l select=1:ncpus=4:mem=8gb:mpiprocs=4
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

cd /scratch/diqingxu/DSA5208/conjugate-gradient

module purge
module load CMake/3.27.6-GCCcore-13.2.0
module load OpenMPI/4.1.6-GCC-13.2.0

export OMP_NUM_THREADS=1

mkdir -p results/mpi

echo "=== MPI Correctness Validation ==="
echo "Node: $(hostname)"
echo "Start: $(date)"

for SIZE in 64 128; do
    for RANKS in 1 2 4; do

        echo "Testing 2D ${SIZE}x${SIZE}, ranks=${RANKS}"

        mpirun -n "$RANKS" \
            ./build/run_mpi_benchmark \
            2d "$SIZE" 3 \
            "results/mpi/validation_2d${SIZE}_p${RANKS}.csv" \
            1

    done
done

echo "=== Validation Completed ==="
date
